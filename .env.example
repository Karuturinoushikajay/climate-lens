# ---- Backend ----
# Leave MONGODB_URI empty to use the process-local in-memory cache.
# docker-compose overrides this with mongodb://mongo:27017
MONGODB_URI=
MONGODB_DATABASE=climate_lens

# Comma-separated list of allowed browser origins (restrict in production!)
ALLOWED_ORIGINS=http://localhost:5173

# Cache time-to-live
OBSERVATION_CACHE_TTL_HOURS=720
ANALYSIS_CACHE_TTL_HOURS=168

# Rate limits (requests per window per client IP, process-local)
RATE_LIMIT_ANALYZE_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_MINUTE=10

# Upstream provider
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RETRIES=2

# Set to "production" to hide docs-friendly debug details
ENVIRONMENT=development

# ---- Frontend (build-time) ----
VITE_API_BASE_URL=http://localhost:8000
