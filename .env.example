# ---- Backend ----
# Leave MONGODB_URI empty to use the process-local in-memory cache.
# docker-compose overrides this with mongodb://mongo:27017
MONGODB_URI=
MONGODB_DATABASE=climate_lens

# Comma-separated list of allowed browser origins (restrict in production!)
ALLOWED_ORIGINS=http://localhost:5173
# Optional full-match regex for extra origins, e.g. Vercel deployment URLs:
# ALLOWED_ORIGIN_REGEX=https://climate-lens(-[a-z0-9]+)?-your-team\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Cache time-to-live
OBSERVATION_CACHE_TTL_HOURS=720
ANALYSIS_CACHE_TTL_HOURS=168

# Rate limits (requests per window per client IP, process-local)
RATE_LIMIT_ANALYZE_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_GEOCODE_PER_MINUTE=60
GEOCODE_CACHE_TTL_HOURS=720
# Proxies in front of the app that append to X-Forwarded-For (0 = use the TCP peer address).
# The client IP is read that many entries from the right, so spoofed left-hand entries are ignored.
TRUSTED_PROXY_HOPS=0

# Upstream provider
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RETRIES=2

# Set to "production" to hide docs-friendly debug details
ENVIRONMENT=development

# ---- Frontend (build-time) ----
VITE_API_BASE_URL=http://localhost:8000
